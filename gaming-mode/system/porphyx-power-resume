#!/bin/sh
# /usr/lib/systemd/system-sleep/porphyx-power-resume
# La EC de ASUS vuelve al modo automatico al despertar: hay que reaplicar.
[ "$1" = "post" ] || exit 0
[ -x /usr/local/bin/porphyx-power ] || exit 0
PORPHYX_POWER_CONF=/etc/porphyx/power.conf \
  /usr/local/bin/porphyx-power apply >/dev/null 2>&1
exit 0
