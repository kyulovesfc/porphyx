[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Copiando /boot (ESP) a /.bootbackup para que entre en los snapshots de Timeshift...
When = PostTransaction
Depends = rsync
Exec = /usr/bin/bash -c 'mountpoint -q /boot && rsync -rt --delete /boot/ /.bootbackup/ || true'
