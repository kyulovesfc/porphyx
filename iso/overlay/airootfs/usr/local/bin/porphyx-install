#!/usr/bin/env bash
# Lanza el instalador de Porphyx Linux (archinstall con la config del repo; disco y usuario se eligen en el menu).
set -Eeuo pipefail
[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"
setvtrgb /etc/porphyx-vtrgb 2>/dev/null || true
command -v nm-online >/dev/null 2>&1 && nm-online -q -t 15 || true
# KYU-NET-CHECK: el instalador es online; si no hay red, ayuda a conectar antes de abrir archinstall
if ! ping -c1 -W3 archlinux.org >/dev/null 2>&1; then
  echo "Sin internet. Conectate para continuar."
  if command -v nmtui >/dev/null 2>&1; then nmtui
  elif command -v iwctl >/dev/null 2>&1; then echo "Wi-Fi: station wlan0 connect <red>   (salir: exit)"; iwctl
  fi
  ping -c1 -W5 archlinux.org >/dev/null 2>&1 || { echo "Sigue sin internet; el instalador es online. Abortando." >&2; exit 1; }
fi
G=$(python3 -c "import importlib.util as u; print(u.find_spec('archinstall').submodule_search_locations[0])")
sed -i "s/title_text = 'Archlinux'/title_text = 'Porphyx Linux'/" "$G/scripts/guided.py" 2>/dev/null || true
# KYU-KEYRING-WAIT: espera al keyring del live (pacman-init); ver drop-in de pacman-init
echo "Preparando keyring del live..."
for _ in $(seq 1 120); do systemctl is-active --quiet pacman-init.service && break; sleep 1; done
systemctl is-active --quiet pacman-init.service || echo "AVISO: pacman-init no termino, el keyring del live puede no estar listo" >&2
# --skip-ntp/--skip-wkd: el live no espera la sincronizacion de hora ni consulta WKD; el sistema instalado si activa NTP (gen-config.py).
# KYU-GPU-DETECT: ajusta los paquetes de GPU al hardware real (sin pciutils; lee /sys)
python3 /opt/porphyx/gpu-config.py /opt/porphyx/archinstall.json /tmp/porphyx-archinstall.json || cp /opt/porphyx/archinstall.json /tmp/porphyx-archinstall.json
exec archinstall --skip-ntp --skip-wkd --plugin /opt/porphyx/plugin.py --config /tmp/porphyx-archinstall.json "$@"
